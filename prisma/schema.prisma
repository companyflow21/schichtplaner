generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  firstName     String
  lastName      String
  nickname      String?
  phone         String?
  profileImage  String?
  locale        String    @default("de")
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships       OrganizationMember[]
  sentMessages      Message[]            @relation("sender")
  messageRecipients MessageRecipient[]
  notes             EmployeeNote[]       @relation("subject")
  authoredNotes     EmployeeNote[]       @relation("author")
  bookings          Booking[]
  timeRecords       TimeRecord[]
  absences          Absence[]
  modRequests       ModRequest[]
  liveLogs          LiveLog[]
  topicPosts        TopicPost[]
  uploadedFiles     PortalFile[]
  createdIssues     BranchIssue[]
  checkins          Checkin[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  address      String?
  nameFormat   NameFormat @default(LASTNAME_FIRSTNAME)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  members           OrganizationMember[]
  customers         Customer[]
  branches          Branch[]
  divisions         Division[]
  schedules         Schedule[]
  timeCategories    TimeCategory[]
  timeSettings      TimeSettings?
  absenceCategories AbsenceCategory[]
  messages          Message[]
  portalFolders     PortalFolder[]
  portalFiles       PortalFile[]
  topics            Topic[]
  holidays          Holiday[]
  settings          OrgSettings?
  timeRecords       TimeRecord[]
  timeCorrections   TimeCorrection[]
  qualificationCatalog Qualification[]
  checkins          Checkin[]
  pushSubscriptions PushSubscription[]
  formerEmployees   FormerEmployee[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(EMPLOYEE)
  isActive       Boolean  @default(true)
  isActivated    Boolean  @default(false)
  activationToken String? @unique
  activationExpiresAt DateTime?
  position       String?
  employmentType String @default("Vollzeit")
  targetHoursPerWeek Float @default(40)
  /// Sollstunden pro Monat; null = nicht festgelegt (nicht dasselbe wie 0).
  targetHoursPerMonth Float?
  qualifications String[] @default([])
  availabilities Availability[]
  joinedAt       DateTime @default(now())
  /// Wer das Konto angelegt hat. Manager erhalten den Aktivierungslink nur
  /// fuer selbst angelegte Konten.
  createdByMemberId String?

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy      OrganizationMember?  @relation("MemberCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  createdMembers OrganizationMember[] @relation("MemberCreator")
  branchAccess   BranchAccess[]
  managedStaff   StaffAssignment[] @relation("StaffManager")
  staffManagers  StaffAssignment[] @relation("StaffEmployee")
  assignedIssues BranchIssue[]

  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@map("organization_members")
}

enum OrgRole {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
}

enum NameFormat {
  LASTNAME_FIRSTNAME
  FIRSTNAME_LASTNAME
  LASTNAME
  FIRSTNAME
  NICKNAME
}

/// Qualifikationskatalog einer Organisation. Mitarbeitende und Schichten
/// speichern weiterhin Namen; beim Speichern gilt die Schreibweise des
/// Katalogs. normalizedName (getrimmt, klein) ist je Organisation eindeutig.
model Qualification {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  normalizedName String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, normalizedName])
  @@map("qualifications")
}

/// Kunde der AKRO-Organisation. Ausschliesslich interne Planungsdaten -
/// es gibt keinen Kundenzugang.
model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branches     Branch[]

  @@unique([organizationId, name])
  @@map("customers")
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  /// Nur Altbestaende duerfen ohne Kunde sein; neue Standorte brauchen einen.
  customerId     String?
  name           String
  address        String?
  meetingPoint   String?
  notes          String?
  positions      String[] @default([])
  isActive       Boolean @default(true)
  createdAt      DateTime @default(now())
  /// Mittelpunkt fuer den GPS-Check-in (WGS84). Ohne Koordinaten kein GPS-Check-in.
  latitude       Float?
  longitude      Float?
  /// Zulaessige Entfernung vom Mittelpunkt in Metern (Vorgabe 50).
  checkinRadiusM Int     @default(50)
  /// Zeiterfassung fuer Schichten dieses Standorts nur nach Check-in.
  gpsCheckinRequired Boolean @default(false)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  schedules    Schedule[]
  access       BranchAccess[]
  issues       BranchIssue[]
  timeRecords  TimeRecord[]
  messages     Message[]
  checkins     Checkin[]

  @@unique([id, organizationId])
  @@index([organizationId, customerId])
  @@map("branches")
}

/// Standortfreigabe: die Rolle bestimmt, welche Rechte ueberhaupt moeglich
/// sind; die Freigabe bestimmt, fuer welchen Standort sie gelten.
model BranchAccess {
  id             String        @id @default(cuid())
  organizationId String
  memberId       String
  branchId       String
  rights         BranchRight[] @default([])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  member OrganizationMember @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Cascade)
  branch Branch             @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([memberId, branchId])
  @@index([organizationId, branchId])
  @@map("branch_access")
}

enum BranchRight {
  VIEW_SCHEDULE
  EDIT_SHIFTS
  PUBLISH_SCHEDULE
  HANDLE_REQUESTS
  VIEW_TIME
  EDIT_TIME
  MANAGE_ISSUES
  REQUEST_SHIFTS
}

/// Ausdrueckliche Zuordnung von Mitarbeitenden zu einem Manager. Rechte auf
/// Personaldaten entstehen nur hierueber, nie ueber eine Standortfreigabe.
model StaffAssignment {
  id               String       @id @default(cuid())
  organizationId   String
  managerMemberId  String
  employeeMemberId String
  rights           StaffRight[] @default([])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  manager  OrganizationMember @relation("StaffManager", fields: [managerMemberId, organizationId], references: [id, organizationId], onDelete: Cascade)
  employee OrganizationMember @relation("StaffEmployee", fields: [employeeMemberId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([managerMemberId, employeeMemberId])
  @@index([organizationId, employeeMemberId])
  @@map("staff_assignments")
}

enum StaffRight {
  ASSIGN_SHIFTS
  VIEW_PROFILE
  EDIT_PROFILE
  MANAGE_ABSENCES
  VIEW_HOURS
  /// Mitarbeiter endgueltig loeschen - nur ausdruecklich vergeben, nie abgeleitet.
  DELETE_EMPLOYEE
}

/// Interne Standortmeldung - getrennt von unbesetzten Schichten.
model BranchIssue {
  id               String      @id @default(cuid())
  organizationId   String
  branchId         String
  title            String
  description      String
  status           IssueStatus @default(OPEN)
  assigneeMemberId String?
  createdById      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  resolvedAt       DateTime?

  branch    Branch              @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Cascade)
  assignee  OrganizationMember? @relation(fields: [assigneeMemberId], references: [id], onDelete: SetNull)
  createdBy User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, branchId, status])
  @@map("branch_issues")
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Division {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  description    String?
  color          String   @default("#6366f1")
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  deletedAt      DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      DivisionMember[]
  shifts       Shift[]

  @@map("divisions")
}

model DivisionMember {
  divisionId String
  userId     String

  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@id([divisionId, userId])
  @@map("division_members")
}

/// Wochenplan eines Standorts. Der Standort einer Schicht ergibt sich
/// ausschliesslich hieraus. Ohne branchId: Altbestand, nur fuer Admins.
model Schedule {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  weekNumber     Int
  year           Int
  isPublic       Boolean  @default(false)
  settingsLayout ScheduleLayout @default(LAYOUT_1)
  showTitle      Boolean  @default(true)
  showPauses     Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shifts       Shift[]
  briefings    Briefing[]
  liveSession  LiveSession?

  @@unique([organizationId, weekNumber, year, branchId])
  @@map("schedules")
}

enum ScheduleLayout {
  LAYOUT_1
  LAYOUT_2
}

model Shift {
  id           String   @id @default(cuid())
  scheduleId   String
  divisionId   String?
  requiredQualifications String[] @default([])
  dayOfWeek    Int
  shiftFrom    String
  shiftTo      String
  maxEmployees Int      @default(1)
  pauseOption  PauseOption @default(PER_HOUR)
  pauseValue   Int      @default(0)
  title        String?
  description  String?
  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  schedule    Schedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  division    Division?    @relation(fields: [divisionId], references: [id])
  messages    Message[]
  bookings    Booking[]
  modRequests ModRequest[] @relation("ModRequestShift")
  /// Antraege, die diese Schicht als Gegen-Schicht eines Tauschs nennen.
  exchangeRequests ModRequest[] @relation("ModRequestTargetShift")
  checkins    Checkin[]

  @@map("shifts")
}

enum PauseOption {
  PER_HOUR
  PER_SHIFT
}

/// Zuweisung einer Person zu einer Schicht. Nach dem Loeschen der Person
/// bleiben begonnene und vergangene Einsaetze als Historie erhalten: userId ist
/// dann leer und formerEmployeeId zeigt auf die Momentaufnahme (genau eins von
/// beiden ist gesetzt, CHECK-Constraint in der Migration).
model Booking {
  id        String   @id @default(cuid())
  shiftId   String
  userId    String?
  formerEmployeeId String?
  bookedAt  DateTime @default(now())
  bookedBy  String?
  /// Zeitpunkt, ab dem die Zuweisung als bestaetigt gilt (siehe confirmation).
  confirmedAt DateTime?
  /// Herkunft der Bestaetigung: PLANNER = von Planung/Administration direkt
  /// zugewiesen oder genehmigt (sofort verbindlich), EMPLOYEE = von der Person
  /// selbst bestaetigt. Leer = Altbestand ohne eindeutige Herkunft.
  confirmation BookingConfirmation?

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  formerEmployee FormerEmployee? @relation(fields: [formerEmployeeId], references: [id], onDelete: Restrict)

  @@unique([shiftId, userId])
  @@index([formerEmployeeId])
  @@map("bookings")
}

enum BookingConfirmation {
  PLANNER
  EMPLOYEE
}

model ModRequest {
  id        String        @id @default(cuid())
  shiftId   String
  userId    String
  state     RequestState  @default(OPEN)
  note      String?
  /// TAKEOVER: offene Schicht anfragen. SWAP: eigene Schicht abgeben
  /// (targetUserId meldet sich). EXCHANGE: eigene Schicht gegen die Schicht
  /// targetShiftId von targetUserId tauschen.
  kind      String @default("TAKEOVER")
  targetUserId String?
  targetShiftId String?
  /// Zustimmung der Gegenseite bei EXCHANGE.
  targetConsentAt DateTime?
  deadline  DateTime?
  sentAt    DateTime      @default(now())
  decidedById String?
  decidedAt   DateTime?
  decisionNote String?

  shift       Shift  @relation("ModRequestShift", fields: [shiftId], references: [id], onDelete: Cascade)
  targetShift Shift? @relation("ModRequestTargetShift", fields: [targetShiftId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId])
  @@map("mod_requests")
}

enum RequestState {
  OPEN
  ACCEPTED
  DECLINED
}

model Briefing {
  id         String   @id @default(cuid())
  scheduleId String
  text       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("briefings")
}

model LiveSession {
  id              String   @id @default(cuid())
  scheduleId      String   @unique
  isActive        Boolean  @default(true)
  deadline        DateTime?
  autoStop        Boolean  @default(false)
  allowExceeds    Boolean  @default(false)
  bookRequests    Boolean  @default(false)
  startedAt       DateTime @default(now())

  schedule Schedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  days     LiveDay[]
  logs     LiveLog[]

  @@map("live_sessions")
}

model LiveDay {
  id            String  @id @default(cuid())
  liveSessionId String
  dayOfWeek     Int
  enabled       Boolean @default(true)

  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  @@unique([liveSessionId, dayOfWeek])
  @@map("live_days")
}

model LiveLog {
  id            String   @id @default(cuid())
  liveSessionId String
  shiftId       String
  userId        String
  action        LiveAction
  loggedAt      DateTime @default(now())

  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("live_logs")
}

enum LiveAction {
  BOOK
  UNBOOK
}

/// Arbeitszeit. Nach dem Loeschen der Person bleibt sie mit formerEmployeeId
/// statt userId erhalten (genau eins von beiden, CHECK-Constraint).
model TimeRecord {
  id             String       @id @default(cuid())
  userId         String?
  formerEmployeeId String?
  organizationId String
  /// Standort der Arbeit; ohne Angabe nur fuer die Person selbst, ihre
  /// Personalverantwortlichen und Admins sichtbar.
  branchId       String?
  startedAt      DateTime?
  endedAt        DateTime?
  pauseStartedAt DateTime?
  breakSeconds   Int @default(0)
  corrections    TimeCorrection[]
  organization Organization @relation(fields: [organizationId], references: [id])
  date           DateTime     @db.Date
  timeFrom       String?
  timeTo         String?
  durationHours  Int?
  durationMinutes Int?
  type           TimeRecordType
  categoryId     String?
  comment        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user     User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  formerEmployee FormerEmployee? @relation(fields: [formerEmployeeId], references: [id], onDelete: Restrict)
  category TimeCategory? @relation(fields: [categoryId], references: [id])
  branch   Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  checkin  Checkin?

  @@index([organizationId, userId, date])
  @@index([organizationId, branchId, date])
  @@index([formerEmployeeId])
  @@map("time_records")
}

enum TimeRecordType {
  MANUAL
  WATCH
  MANUAL_DURATION
}

model TimeCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  enabled        Boolean  @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      TimeRecord[]

  @@map("time_categories")
}

model TimeSettings {
  id               String   @id @default(cuid())
  organizationId   String   @unique
  trackingOptions  String?
  watchAutoStop    Boolean  @default(false)
  warningsEnabled  Boolean  @default(false)
  warningsMaxHours Int      @default(10)
  whoCanUse        WhoCanUse @default(ALL)
  useCategories    Boolean  @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("time_settings")
}

enum WhoCanUse {
  ALL
  CHOOSE
}

model Absence {
  id         String       @id @default(cuid())
  userId     String
  categoryId String
  dateFrom   DateTime     @db.Date
  dateTo     DateTime     @db.Date
  note       String?
  status     AbsenceStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category AbsenceCategory @relation(fields: [categoryId], references: [id])

  @@map("absences")
}

enum AbsenceStatus {
  PENDING
  APPROVED
  DECLINED
}

model AbsenceCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String   @default("#ef4444")
  isPaid         Boolean  @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  absences     Absence[]

  @@map("absence_categories")
}

model Holiday {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  date           DateTime @db.Date
  country        String   @default("DE")
  state          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("holidays")
}

model Message {
  id             String   @id @default(cuid())
  organizationId String
  senderId       String?
  subject        String
  body           String
  parentId       String?
  shiftId        String?
  shift          Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  /// Optionaler Standortbezug (ohne konkrete Schicht).
  branchId       String?
  branch         Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Leer, wenn das Konto der absendenden Person geloescht wurde.
  sender       User?              @relation("sender", fields: [senderId], references: [id], onDelete: SetNull)
  parent       Message?           @relation("replies", fields: [parentId], references: [id])
  replies      Message[]          @relation("replies")
  recipients   MessageRecipient[]

  @@map("messages")
}

model MessageRecipient {
  messageId String
  userId    String
  isRead    Boolean @default(false)
  isDeleted Boolean @default(false)
  /// Push-Versand erledigt (gesendet oder bewusst uebersprungen). Offene
  /// Zeilen arbeitet der Server-Hintergrundlauf ab (src/lib/push.ts).
  pushedAt  DateTime?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@map("message_recipients")
}

model PortalFolder {
  id             String   @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       PortalFolder? @relation("subfolders", fields: [parentId], references: [id])
  children     PortalFolder[] @relation("subfolders")
  files        PortalFile[]

  @@map("portal_folders")
}

model PortalFile {
  id             String   @id @default(cuid())
  organizationId String
  folderId       String?
  name           String
  path           String
  size           Int
  mimeType       String?
  uploadedById   String?
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folder       PortalFolder? @relation(fields: [folderId], references: [id])
  uploadedBy   User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@map("portal_files")
}

model Topic {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts        TopicPost[]

  @@map("topics")
}

model TopicPost {
  id        String   @id @default(cuid())
  topicId   String
  userId    String?
  text      String
  createdAt DateTime @default(now())

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("topic_posts")
}

model EmployeeNote {
  id         String   @id @default(cuid())
  subjectId  String
  authorId   String?
  text       String
  createdAt  DateTime @default(now())

  subject User @relation("subject", fields: [subjectId], references: [id], onDelete: Cascade)
  author  User? @relation("author", fields: [authorId], references: [id], onDelete: SetNull)

  @@map("employee_notes")
}

model Availability {
  id String @id @default(cuid())
  organizationId String
  userId String
  date DateTime @db.Date
  timeFrom String
  timeTo String
  available Boolean
  note String?
  member OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@index([organizationId, userId, date])
  @@map("availabilities")
}

model TimeCorrection {
  id String @id @default(cuid())
  organizationId String
  recordId String
  requesterId String
  reason String
  before Json
  proposed Json
  status AbsenceStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  record TimeRecord @relation(fields: [recordId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@map("time_corrections")
}

/// Anwesenheitsnachweis zu Beginn einer Schicht: Serverzeit und ob die Person
/// am Dienstort war. Gespeichert werden nur Entfernung, Genauigkeit und Alter
/// der Browser-Position - keine Koordinaten, kein Bewegungsprofil. Browser-
/// Positionen sind manipulierbar; der Eintrag ist kein faelschungssicherer Beweis.
model Checkin {
  id             String   @id @default(cuid())
  organizationId String
  /// Leer nach dem Loeschen der Person; dann ist formerEmployeeId gesetzt.
  userId         String?
  formerEmployeeId String?
  shiftId        String
  branchId       String
  /// Gestartete Zeiterfassung (bei MANUAL erst nach Freigabe).
  timeRecordId   String?  @unique
  /// GPS | MANUAL
  method         String
  /// CONFIRMED (GPS bestanden) | PENDING | APPROVED | DECLINED (manuelle Freigabe)
  /// | SUPERSEDED (offener Antrag, erledigt durch spaeteren GPS-Check-in)
  status         String
  /// Massgeblicher Zeitpunkt: Serverzeit des Check-ins bzw. des Antrags.
  createdAt      DateTime @default(now())
  /// Minuten nach Schichtbeginn (negativ = vor Beginn), Ortszeit Europe/Berlin.
  lateMinutes    Int
  distanceM      Int?
  accuracyM      Int?
  positionAgeS   Int?
  /// Warum GPS nicht gereicht hat: DENIED | UNAVAILABLE | INACCURATE | STALE | OUTSIDE | NO_COORDINATES
  failure        String?
  reason         String?
  reviewedById   String?
  reviewedAt     DateTime?
  decisionNote   String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Restrict)
  formerEmployee FormerEmployee? @relation(fields: [formerEmployeeId], references: [id], onDelete: Restrict)
  shift        Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  timeRecord   TimeRecord?  @relation(fields: [timeRecordId], references: [id], onDelete: SetNull)

  /// Hoechstens ein wirksamer Eintrag (CONFIRMED, APPROVED, PENDING) je Schicht
  /// und Person: Teilindex "checkins_active_key" in der Migration (Prisma kennt
  /// keine Teilindizes). Abgelehnte und erledigte Eintraege bleiben als Verlauf.
  @@index([shiftId, userId])
  @@index([organizationId, branchId, createdAt])
  @@index([organizationId, status])
  @@map("checkins")
}

/// Historische Momentaufnahme einer geloeschten Person: nur der Name, damit
/// vergangene Einsaetze, Arbeitszeiten und Check-ins weiter auswertbar bleiben.
/// Kein Konto, keine Kontakt-, Vertrags- oder Qualifikationsdaten.
model FormerEmployee {
  id             String   @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  deletedAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  timeRecords  TimeRecord[]
  checkins     Checkin[]

  @@index([organizationId])
  @@map("former_employees")
}

model OrgSettings {
  id                String  @id @default(cuid())
  organizationId    String  @unique
  aiEnabled         Boolean @default(false)
  aiAutoPlanner     Boolean @default(false)
  aiAnomalyDetection Boolean @default(false)
  aiChatEnabled     Boolean @default(false)
  aiForecast        Boolean @default(false)
  aiSmartBriefing   Boolean @default(false)
  smsEnabled        Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("org_settings")
}

/// Browser-Push-Abo eines Geraets (Web-Push-Standard). Der Server sendet
/// nur inhaltsleere Hinweise ("neue Mitteilung"); Details stehen in der App.
model PushSubscription {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  endpoint       String   @unique
  p256dh         String
  auth           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
